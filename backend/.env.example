# Copy to backend/.env and adjust. Never commit real secrets.
ENVIRONMENT=development
# SQLite demo mode (default) or PostgreSQL for multi-user deployments:
# DATABASE_URL=postgresql+psycopg2://verdant:verdant@localhost:5432/verdant
DATABASE_URL=sqlite:///./verdant.db
# REQUIRED in production: a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8
AUTO_MIGRATE=true
SIMULATOR_ENABLED=true
# Set true when served over HTTPS
COOKIE_SECURE=false
# Optional providers — leave empty to use the documented fallbacks
MARKET_API_URL=
MARKET_API_KEY=
OBJECT_DETECTOR_MODEL_PATH=
